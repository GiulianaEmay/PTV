# Puerto local del servidor
PORT=3000

# Clave usada para firmar las cookies de sesion. Cambiala por un valor largo
# y aleatorio antes de publicar en produccion.
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Credenciales del primer usuario administrador (Emay). Se crean automaticamente
# la primera vez que arranca el servidor si todavia no existe ningun admin.
# Despues de crearlo puedes borrar estas dos lineas o dejarlas (no se vuelven a usar).
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=elige-una-contrasena-segura

# Nota: el token de acceso a Loyverse de cada cliente YA NO va aqui.
# Se administra por empresa desde el Panel de Administracion (admin.html),
# porque cada cliente (empresa) tiene su propio token.
